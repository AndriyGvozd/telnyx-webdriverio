{
  "name": "Telnyx.WebdriverIO",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.5",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/visual-service": "^10.1.0",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^6.0.9",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "bash -c 'exit_code=0; npm run test:chrome || exit_code=1; npm run test:firefox || exit_code=1; npm run test:safari || exit_code=1; npm run test:mobile || exit_code=1; exit $exit_code'",
    "test:file": "cross-env TEST_ENV=prod wdio run ./config/wdio.safari.conf.ts --spec",
    "test:chrome": "cross-env TEST_ENV=prod wdio run ./config/wdio.chrome.conf.ts",
    "test:chrome:staging": "cross-env TEST_ENV=staging wdio run ./config/wdio.chrome.conf.ts",
    "test:chrome:dev": "cross-env TEST_ENV=dev wdio run ./config/wdio.chrome.conf.ts",
    "test:firefox": "cross-env TEST_ENV=prod wdio run ./config/wdio.firefox.conf.ts",
    "test:firefox:staging": "cross-env TEST_ENV=staging wdio run ./config/wdio.firefox.conf.ts",
    "test:firefox:dev": "cross-env TEST_ENV=dev wdio run ./config/wdio.firefox.conf.ts",
    "test:safari": "cross-env TEST_ENV=prod wdio run ./config/wdio.safari.conf.ts",
    "test:safari:staging": "cross-env TEST_ENV=staging wdio run ./config/wdio.safari.conf.ts",
    "test:safari:dev": "cross-env TEST_ENV=dev wdio run ./config/wdio.safari.conf.ts",
    "test:mobile": "cross-env TEST_ENV=prod wdio run ./config/wdio.mobile.conf.ts",
    "test:mobile:staging": "cross-env TEST_ENV=staging wdio run ./config/wdio.mobile.conf.ts",
    "test:mobile:dev": "cross-env TEST_ENV=dev wdio run ./config/wdio.mobile.conf.ts",
    "report:clean": "rimraf allure-results allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",

    "docker:test:chrome": "docker compose run --rm -e SELENIUM_HOST=selenium-chrome tests npm run test:chrome",
    "docker:test:firefox": "docker compose run --rm -e SELENIUM_HOST=selenium-firefox tests npm run test:firefox",
    "docker:test:mobile": "docker compose run --rm -e SELENIUM_HOST=selenium-chrome tests npm run test:mobile",
    "docker:down": "docker compose down"
  }
}
